# Application runtime. NODE_ENV: development | test | production.
# PORT must be an integer from 1 through 65535.
# Swagger is served at /api/docs only when SWAGGER_ENABLED is true.
NODE_ENV=development
PORT=3000
SWAGGER_ENABLED=true

# Google-only authentication. Keep disabled until local Google OAuth credentials are
# configured. GOOGLE_REDIRECT_URI must exactly match an Authorized redirect URI in
# Google Cloud Console. AUTH_SUCCESS_REDIRECT_URI is a same-origin landing path only;
# it never receives a token and defaults to the local Swagger UI.
GOOGLE_AUTH_ENABLED=false
# GOOGLE_CLIENT_ID=replace-with-local-google-client-id
# GOOGLE_CLIENT_SECRET=replace-with-local-google-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
AUTH_SUCCESS_REDIRECT_URI=/api/docs

# Application session policy. Production must inject a unique secret with at least
# 32 characters; this committed value is development-only.
JWT_ACCESS_SECRET=local_jwt_secret_change_me_32_chars
JWT_ISSUER=hotel-management-api
JWT_AUDIENCE=hotel-management-web
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=2592000
OAUTH_TRANSACTION_TTL_SECONDS=600
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# AUTH_REDIS_KEY_PREFIX namespaces authentication state (OAuth transactions and
# session revocations). Rate-limit counters live under RATE_LIMIT_REDIS_KEY_PREFIX
# below, because one limiter serves authentication and uploads alike.
AUTH_REDIS_KEY_PREFIX=hotel:auth

# Local Docker Compose dependencies. These are development-only examples; change
# them in an ignored .env file if the host is shared or reachable by other users.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=hotel_management
MYSQL_USER=hotel_app
MYSQL_PASSWORD=local_mysql_change_me
MYSQL_ROOT_PASSWORD=local_mysql_root_change_me
# MYSQL_POOL_SIZE (4-100) bounds concurrent MySQL connections. Every request that
# locks a room or serves a public availability read holds one connection for the
# duration of its transaction, so this is the real cap on concurrent write and
# search traffic. The floor is 4 because one admin room read already acquires three
# connections at once (amenities plus two attachment reads) and the readiness probe
# shares the same pool. Keep it below the server's max_connections divided by the
# number of API instances plus the CLI runners. Acquisition is bounded at four
# waiters per connection: beyond that the request is refused with
# 503 DATABASE_OVERLOADED instead of queueing behind a saturated pool.
MYSQL_POOL_SIZE=10

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_TIMEOUT_MS (100-10000) bounds every application Redis client on the request
# path: the connect attempt, each command, and the loading-retry wait. It is not the
# health-probe bound below, because tightening probes must not shorten login and
# upload availability. A store that cannot answer within it is treated as
# unavailable, and rate-limited routes then fail closed.
REDIS_TIMEOUT_MS=1000
# One shared, fail-closed limiter serves every request budget, so its counters get
# their own namespace instead of an owning module's. Required in production: two
# environments sharing one Redis instance would otherwise both default to this value
# and spend each other's budgets. Readiness writes an expiring key here to prove the
# store accepts writes, not merely that it answers PING.
RATE_LIMIT_REDIS_KEY_PREFIX=hotel:rate

# Booking policy. HOTEL_TIMEZONE determines the business-local calendar date used
# when validating a stay; it must be configured explicitly in production. Booking
# creation is limited per authenticated user before it takes a database lock. An
# idempotency record is retained for at least this many hours; Phase 7 will own its
# scheduled expiry cleanup, so a retained key can remain unavailable for longer.
HOTEL_TIMEZONE=Asia/Ho_Chi_Minh
BOOKING_CREATE_RATE_LIMIT_MAX=10
BOOKING_CREATE_RATE_LIMIT_WINDOW_SECONDS=60
BOOKING_IDEMPOTENCY_RETENTION_HOURS=24

# Application object-storage configuration. These names are provider-neutral: local
# defaults target Compose's MinIO; production can use S3 or another compatible service.
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_BUCKET=hotel-assets
OBJECT_STORAGE_ACCESS_KEY=hotel_local
OBJECT_STORAGE_SECRET_KEY=local_minio_change_me

# Attachment infrastructure limits, shared by every attachable target because one
# storage adapter and one cleanup runner serve all of them. Storage stays private;
# API responses expose short-lived presigned reads. Cleanup grace must be greater
# than the storage operation timeout, or the cleanup runner could delete an object
# whose upload is still in flight.
# The upload budget is charged per authenticated uploader per window (not per
# address and not globally), in a route guard that answers 429 before the request
# body is read. An unreachable or stalled limiter answers 503 rather than allowing
# an unbounded upload path.
ATTACHMENT_PRESIGN_TTL_SECONDS=900
ATTACHMENT_UPLOAD_RATE_LIMIT_MAX=10
ATTACHMENT_UPLOAD_RATE_LIMIT_WINDOW_SECONDS=60
ATTACHMENT_STORAGE_TIMEOUT_MS=10000
ATTACHMENT_CLEANUP_GRACE_MS=60000

# Content limits stay per target/association: how large a room photo may be is a
# product decision for that surface, not a property of the storage layer. A future
# avatar surface adds its own limits (for example USER_AVATAR_MAX_BYTES).
ROOM_IMAGE_MAX_BYTES=5242880
ROOM_IMAGE_MAX_ALBUM_COUNT=20

# Local MinIO container configuration only; the application never reads these names.
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=hotel_local
MINIO_ROOT_PASSWORD=local_minio_change_me

# Each readiness dependency is checked concurrently and fails after this bound.
HEALTH_CHECK_TIMEOUT_MS=1000

# Local Mailpit container configuration only; application mail delivery begins in
# Phase 5 with separate provider-facing configuration.
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MAILPIT_MAX_MESSAGES=5000
