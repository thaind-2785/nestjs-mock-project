# Application runtime. NODE_ENV: development | test | production.
# PORT must be an integer from 1 through 65535.
# Swagger is served at /api/docs only when SWAGGER_ENABLED is true.
NODE_ENV=development
PORT=3000
SWAGGER_ENABLED=true

# Local Docker Compose dependencies. These are development-only examples; change
# them in an ignored .env file if the host is shared or reachable by other users.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=hotel_management
MYSQL_USER=hotel_app
MYSQL_PASSWORD=local_mysql_change_me
MYSQL_ROOT_PASSWORD=local_mysql_root_change_me

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=hotel_local
MINIO_ROOT_PASSWORD=local_minio_change_me
MINIO_ACCESS_KEY=hotel_local
MINIO_SECRET_KEY=local_minio_change_me
MINIO_BUCKET=hotel-assets

# Each readiness dependency is checked concurrently and fails after this bound.
HEALTH_CHECK_TIMEOUT_MS=1000

MAILPIT_HOST=127.0.0.1
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MAILPIT_MAX_MESSAGES=5000
