        </mxCell>
        <mxCell id="ops-payments" value="&lt;b&gt;payments (reference, OPTIONAL)&lt;/b&gt;&lt;br&gt;PK id BIGINT" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=12;" vertex="1" parent="o1">
          <mxGeometry x="50" y="590" width="240" height="85" as="geometry" />
        </mxCell>
        <mxCell id="outbox" value="&lt;b&gt;outbox_events&lt;/b&gt;&lt;br&gt;PK id CHAR(36)&lt;br&gt;event_type VARCHAR(100)&lt;br&gt;payload JSON&lt;br&gt;available_at DATETIME&lt;br&gt;status ENUM&lt;br&gt;UK idempotency_key VARCHAR(255)&lt;br&gt;locked_at DATETIME NULL&lt;br&gt;lock_expires_at DATETIME NULL&lt;br&gt;locked_by VARCHAR(100) NULL&lt;br&gt;processed_at DATETIME NULL&lt;br&gt;attempts SMALLINT&lt;br&gt;created_at" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="o1">
