  <diagram id="async-ops" name="02 - Async and Operations">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="o0" />
        <mxCell id="o1" parent="o0" />
        <mxCell id="ops-title" value="HOTEL MANAGEMENT - ASYNC / OPERATIONS TABLES&lt;br&gt;&lt;font style=&quot;font-size:12px;font-weight:normal&quot;&gt;Purple = operational reliability | Grey = referenced core aggregate&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;" vertex="1" parent="o1">
          <mxGeometry x="30" y="20" width="1400" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ops-users" value="&lt;b&gt;users (reference)&lt;/b&gt;&lt;br&gt;PK id BIGINT" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=12;" vertex="1" parent="o1">
