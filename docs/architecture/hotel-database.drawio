          <mxGeometry height="110" width="270" x="1160" y="330" as="geometry" />
        </mxCell>
        <mxCell id="attachments" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" value="&lt;b&gt;attachments (POLYMORPHIC)&lt;/b&gt;&lt;br&gt;PK id CHAR(36)&lt;br&gt;FK uploader_user_id -&amp;gt; users.id&lt;br&gt;object_type VARCHAR(50)&lt;br&gt;object_id BIGINT (logical target; no FK)&lt;br&gt;association_type VARCHAR(50)&lt;br&gt;position SMALLINT&lt;br&gt;UK object_key VARCHAR(1024)&lt;br&gt;mime_type VARCHAR(100)&lt;br&gt;size_bytes BIGINT&lt;br&gt;UK(object_type, object_id, association_type, position)&lt;br&gt;created_at, updated_at" vertex="1">
          <mxGeometry height="250" width="300" x="10" y="80" as="geometry" />
        </mxCell>
        <mxCell id="room-times" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="&lt;b&gt;room_times&lt;/b&gt;&lt;br&gt;PK id BIGINT&lt;br&gt;FK room_id -&amp;gt; rooms.id&lt;br&gt;available_from DATE&lt;br&gt;available_to DATE (exclusive)&lt;br&gt;status ENUM(ACTIVE, INACTIVE)&lt;br&gt;created_at, updated_at&lt;br&gt;CHECK(available_from &amp;lt; available_to)" vertex="1">
          <mxGeometry height="200" width="300" x="1140" y="590" as="geometry" />
        </mxCell>
        <mxCell id="bookings" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="&lt;b&gt;bookings&lt;/b&gt;&lt;br&gt;PK id BIGINT&lt;br&gt;UK public_id CHAR(26)&lt;br&gt;FK user_id -&amp;gt; users.id&lt;br&gt;FK room_time_id -&amp;gt; room_times.id&lt;br&gt;check_in DATE&lt;br&gt;check_out DATE (exclusive)&lt;br&gt;status ENUM&lt;br&gt;price_amount BIGINT&lt;br&gt;currency CHAR(3)&lt;br&gt;rejection_reason TEXT NULL&lt;br&gt;version BIGINT&lt;br&gt;created_at, updated_at&lt;br&gt;CHECK(check_in &amp;lt; check_out)" vertex="1">
          <mxGeometry height="315" width="310" x="1510" y="260" as="geometry" />
        </mxCell>
        <mxCell id="booking-history" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" value="&lt;b&gt;booking_status_history&lt;/b&gt;&lt;br&gt;PK id BIGINT&lt;br&gt;FK booking_id -&amp;gt; bookings.id&lt;br&gt;from_status ENUM NULL&lt;br&gt;to_status ENUM&lt;br&gt;actor_type ENUM(USER, ADMIN, SYSTEM)&lt;br&gt;FK actor_user_id -&amp;gt; users.id NULL&lt;br&gt;reason TEXT NULL&lt;br&gt;created_at DATETIME&lt;br&gt;&lt;i&gt;Append-only&lt;/i&gt;" vertex="1">
          <mxGeometry height="240" width="320" x="1900" y="100" as="geometry" />
        </mxCell>
        <mxCell id="reviews" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" value="&lt;b&gt;reviews (OPTIONAL)&lt;/b&gt;&lt;br&gt;PK id BIGINT&lt;br&gt;UK/FK booking_id -&amp;gt; bookings.id&lt;br&gt;FK user_id -&amp;gt; users.id&lt;br&gt;rating TINYINT CHECK 1..5&lt;br&gt;comment TEXT NULL&lt;br&gt;status ENUM(PENDING, APPROVED, REJECTED)&lt;br&gt;moderation_reason TEXT NULL&lt;br&gt;created_at, updated_at" vertex="1">
