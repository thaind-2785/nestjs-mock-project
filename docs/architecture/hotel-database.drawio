      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title-core" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;" value="HOTEL MANAGEMENT - CORE DATABASE (MySQL 8)&lt;br&gt;&lt;font style=&quot;font-size:12px;font-weight:normal&quot;&gt;Blue = required domain | Yellow = auth/audit | Green = optional | Grey = join/file metadata&lt;/font&gt;" vertex="1">
