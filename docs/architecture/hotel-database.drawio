        </mxCell>
        <mxCell id="users" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="&lt;b&gt;users&lt;/b&gt;&lt;br&gt;PK id BIGINT&lt;br&gt;UK email VARCHAR(255)&lt;br&gt;display_name VARCHAR(100)&lt;br&gt;role ENUM(USER, ADMIN)&lt;br&gt;status ENUM(ACTIVE, INACTIVE)&lt;br&gt;email_verified_at DATETIME&lt;br&gt;created_at, updated_at" vertex="1">
