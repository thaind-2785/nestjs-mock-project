          <mxGeometry height="190" width="290" x="390" y="350" as="geometry" />
        </mxCell>
        <mxCell id="user-status-history" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" value="&lt;b&gt;user_status_history&lt;/b&gt;&lt;br&gt;PK id BIGINT&lt;br&gt;FK user_id -&amp;gt; users.id&lt;br&gt;FK actor_user_id -&amp;gt; users.id&lt;br&gt;from_status ENUM&lt;br&gt;to_status ENUM&lt;br&gt;reason TEXT&lt;br&gt;created_at DATETIME" vertex="1">
