        </mxCell>
        <mxCell id="auth-identities" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" value="&lt;b&gt;auth_identities&lt;/b&gt;&lt;br&gt;PK id BIGINT&lt;br&gt;FK user_id -&amp;gt; users.id&lt;br&gt;provider ENUM(GOOGLE)&lt;br&gt;provider_subject VARCHAR(255)&lt;br&gt;provider_email VARCHAR(255)&lt;br&gt;UK(provider, provider_subject)&lt;br&gt;UK(user_id, provider)" vertex="1">
          <mxGeometry height="205" width="290" x="390" y="100" as="geometry" />
        </mxCell>
